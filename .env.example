# Spotify developer app. This is not your Spotify username or password.
# Use the app's 32-character Client ID from:
# https://developer.spotify.com/dashboard
# Create an app at https://developer.spotify.com/dashboard and add this exact
# redirect URI to the app settings.
SPOTIFY_CLIENT_ID=your_spotify_client_id

# TinyTuya local LAN backend. Keep every comma-separated list in the same device order.
# Local keys are secrets; put real values only in .env.
TUYA_DEVICE_IDS=your_first_tuya_device_id,your_second_tuya_device_id
TUYA_DEVICE_IPS=192.168.1.101,192.168.1.102
TUYA_LOCAL_KEYS=your_first_local_key,your_second_local_key
TUYA_PROTOCOL_VERSIONS=3.3,3.3

# Optional readable names used in logs. When set, the count must match the
# number of configured devices.
TUYA_DEVICE_LABELS=desk bulb,floor bulb
