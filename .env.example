# Spotify developer app. This is not your Spotify username or password.
# Use the app's 32-character Client ID from:
# https://developer.spotify.com/dashboard
# Create an app at https://developer.spotify.com/dashboard and add this exact
# redirect URI to the app settings.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Spotify polling interval in seconds.
POLL_SECONDS=1

# Ignore album-art colors that are too dark or gray for useful bulb output.
ALBUM_COLOR_MIN_LUMINANCE=0.08
ALBUM_COLOR_MIN_SATURATION=0.12
ALBUM_COLOR_FALLBACK=#ff6600

# Light backend: tuya_cloud or homeassistant
LIGHT_BACKEND=tuya_cloud
# same sends one album-art color to every bulb.
# album_palette assigns different colors from the same album art.
LIGHT_COLOR_MODE=album_palette

# Tuya Cloud backend.
# India is usually https://openapi.tuyain.com. Other common endpoints:
# https://openapi.tuyaus.com, https://openapi-ueaz.tuyaus.com,
# https://openapi.tuyaeu.com, https://openapi-weaz.tuyaeu.com,
# https://openapi.tuyacn.com
TUYA_ENDPOINT=https://openapi.tuyain.com
TUYA_ACCESS_ID=your_tuya_access_id
TUYA_ACCESS_SECRET=your_tuya_access_secret
# Use TUYA_DEVICE_IDS for multiple Tuya bulbs. TUYA_DEVICE_ID remains supported
# for single-bulb setups.
TUYA_DEVICE_IDS=your_first_tuya_device_id,your_second_tuya_device_id
TUYA_DEVICE_LABELS=desk bulb,floor bulb
TUYA_DEVICE_ID=your_tuya_device_id

# Usually auto-detected from the device specification. Override only if needed.
TUYA_ENSURE_ON_COLOR_MODE=false
TUYA_SWITCH_CODE=auto
TUYA_WORK_MODE_CODE=auto
TUYA_COLOR_CODE=auto
TUYA_COLOR_VALUE_FORMAT=auto
TUYA_MIN_VALUE_PERCENT=35

# Home Assistant backend.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_long_lived_access_token
HOME_ASSISTANT_ENTITY_ID=light.wipro_bulb
